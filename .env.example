export DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pattern_draw?schema=public"
# NEXTAUTH_URL is optional. Leave it unset to support multiple domains (the URL is
# derived from the request host). Setting it pins all sign-ins to that single origin.
# export NEXTAUTH_URL="http://localhost:3000"
export NEXTAUTH_SECRET="generate with openssl rand -base64 32"
export GOOGLE_CLIENT_ID="your-google-client-id"  # Optional
export GOOGLE_CLIENT_SECRET="your-google-client-secret"  # Optional